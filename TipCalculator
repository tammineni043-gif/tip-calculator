
import javafx.application.Application;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.control.Slider;
import javafx.scene.control.TextField;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class TipCalculator extends Application {

    @Override
    public void start(Stage stage) {

        Label title = new Label("Tip Calculator");

        Label billLabel = new Label("Enter Bill Amount (₹):");
        TextField billField = new TextField();
        billField.setPromptText("Enter bill amount");

        Label tipLabel = new Label("Tip Percentage: 10%");

        Slider tipSlider = new Slider(0, 30, 10);
        tipSlider.setShowTickLabels(true);
        tipSlider.setShowTickMarks(true);
        tipSlider.setMajorTickUnit(10);
        tipSlider.setBlockIncrement(1);

        Label tipAmountLabel = new Label("Tip Amount: ₹0.00");
        Label totalLabel = new Label("Total Amount: ₹0.00");
        Label messageLabel = new Label();

        Button calculateButton = new Button("Calculate Tip");
        Button clearButton = new Button("Clear");

        // Respond to slider interaction
        tipSlider.valueProperty().addListener(
            (observable, oldValue, newValue) -> {
                tipLabel.setText(
                    "Tip Percentage: " + newValue.intValue() + "%"
                );
            }
        );

        // Respond to Calculate button click
        calculateButton.setOnAction(event -> {
            try {
                double bill = Double.parseDouble(
                    billField.getText().trim()
                );
                double percentage = tipSlider.getValue();

                if (!Double.isFinite(bill) || bill < 0) {
                    messageLabel.setText(
                        "Please enter a valid non-negative bill."
                    );
                    return;
                }

                double tip = bill * percentage / 100;
                double total = bill + tip;

                tipAmountLabel.setText(
                    String.format("Tip Amount: ₹%.2f", tip)
                );
                totalLabel.setText(
                    String.format("Total Amount: ₹%.2f", total)
                );
                messageLabel.setText("Calculation successful!");

            } catch (NumberFormatException e) {
                messageLabel.setText(
                    "Please enter a valid bill amount."
                );
            }
        });

        // Respond to Clear button click
        clearButton.setOnAction(event -> {
            billField.clear();
            tipSlider.setValue(10);
            tipAmountLabel.setText("Tip Amount: ₹0.00");
            totalLabel.setText("Total Amount: ₹0.00");
            messageLabel.setText("");
        });

        VBox root = new VBox(12);
        root.setPadding(new Insets(20));
        root.setAlignment(Pos.CENTER);
        root.setStyle(
            "-fx-background-color: #f0f8ff;"
        );

        title.setStyle(
            "-fx-font-size: 24px; -fx-font-weight: bold;"
        );
        calculateButton.setStyle(
            "-fx-background-color: #2196f3; -fx-text-fill: white;"
        );

        root.getChildren().addAll(
            title,
            billLabel,
            billField,
            tipLabel,
            tipSlider,
            calculateButton,
            clearButton,
            tipAmountLabel,
            totalLabel,
            messageLabel
        );

        Scene scene = new Scene(root, 350, 450);

        stage.setTitle("JavaFX Tip Calculator");
        stage.setScene(scene);
        stage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
